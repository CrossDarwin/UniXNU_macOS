+int ArmDTPlatform::haltRestart (unsigned int type)
+{
+  uint64_t function;
+  switch (type) {
+  case kPERestartCPU:
+    function = 0x84000009; // PSCI SYSTEM_RESET
+    break;
+  case kPEHaltCPU:
+  case kPEUPSDelayHaltCPU:
+    function = 0x84000008; // PSCI SYSTEM_OFF
+    break;
+  default:
+    // Preserve panic synchronization and the deliberate hang path.
+    return IODTPlatformExpert::haltRestart (type);
+  }
+  armdt_platform_power_type = type;
+  armdt_platform_power_result = platformPowerCall (function);
+  // Successful power transitions never return. Retain firmware refusal for diagnosis.
+  return -1;
+}
